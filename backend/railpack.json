{
  "$schema": "https://schema.railpack.com",
  "provider": "java",
  "steps": {
    "build": {
      "commands": [
        "mkdir -p target/classes",
        "mkdir -p target/lib",
        "cp lib/*.jar target/lib/",
        "find src -type f -name '*.java' > sources.txt",
        "javac -cp 'lib/*' -d target/classes @sources.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "java -cp 'target/classes:target/lib/*' server.FoundItServer"
  }
}