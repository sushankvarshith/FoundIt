{
  "$schema": "https://schema.railpack.com",
  "provider": "java",
  "steps": {
    "build": {
      "commands": [
        "mkdir -p target/classes",
        "find . -type f -name \"*.java\" > sources.txt",
        "javac -cp \"lib/*\" -d target/classes @sources.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "java -cp \"target/classes:lib/*\" server.FoundItServer"
  }
}